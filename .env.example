# .env.example for ORBIT project

# Backend configuration
# --------------------------------------------------
# Allowed origins for CORS (comma-separated). Example for production:
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
ALLOWED_ORIGINS=

# Maximum upload size (bytes). Default 10MB.
ORBIT_MAX_UPLOAD_BYTES=10485760

# Maximum task string length.
ORBIT_MAX_TASK_LENGTH=2000

# CSV limits
ORBIT_MAX_CSV_ROWS=100000
ORBIT_MAX_CSV_COLUMNS=100

# Rate limiting
ORBIT_RATE_LIMIT_REQUESTS=60
ORBIT_RATE_LIMIT_WINDOW_SECONDS=60

# Concurrency limits
ORBIT_MAX_CONCURRENT_REQUESTS=4
ORBIT_REQUEST_TIMEOUT_SECONDS=60
ORBIT_AGENT_EXECUTOR_WORKERS=4

# Gemini integration (optional)
ORBIT_ENABLE_GEMINI=false
GEMINI_API_KEY=

# FreeLLMAPI (optional)
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=
FREELLMAPI_MODEL=auto

# DeepSeek (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Frontend Vite environment variables (used at build time)
VITE_BACKEND_URL=   # e.g., https://your-backend.onrender.com
VITE_USE_MOCK_EXECUTION=false
