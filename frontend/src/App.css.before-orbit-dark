@keyframes pulse {
  0% { transform: translateY(0) scale(1); opacity: 1 }
  50% { transform: translateY(-3px) scale(1.02); opacity: 0.95 }
  100% { transform: translateY(0) scale(1); opacity: 1 }
}

@keyframes glow-pulse {
  0% { box-shadow: 0 0 0 0 rgba(110,124,255,0.14) }
  70% { box-shadow: 0 0 20px 8px rgba(110,124,255,0.04) }
  100% { box-shadow: 0 0 0 0 rgba(110,124,255,0.0) }
}

/* Agent running/completed visual states */
.agent-card--running {
  border-color: rgba(124, 141, 255, 0.6);
  transform: translateY(-4px);
  animation: glow-pulse 1600ms infinite ease-in-out;
}

.agent-card--completed {
  border-color: rgba(98, 217, 160, 0.6);
  box-shadow: 0 6px 28px rgba(98, 217, 160, 0.06);
  transition: border-color 280ms ease, box-shadow 280ms ease, transform 200ms ease;
}

/* Activity marker transitions */
.activity-marker {
  transition: background 240ms ease, transform 220ms ease, color 200ms ease;
}

.activity-item--done .activity-marker {
  transform: scale(1.05);
}

.activity-item--active .activity-marker {
  color: white;
}

/* Result reveal */
.results { opacity: 0; transform: translateY(8px); transition: opacity 320ms ease, transform 320ms ease; }
.results--visible { opacity: 1; transform: translateY(0); }

/* Respect reduced motion preference */
@media (prefers-reduced-motion: reduce) {
  .agent-card--running, .agent-card--completed, .activity-list li, .results { animation: none !important; transition: none !important; transform: none !important; }
}

