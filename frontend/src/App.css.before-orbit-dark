:root {
  --bg: #0b0e14;
  --panel: #0f1419;
  --panel-soft: #0c1114;
  --panel-raised: #111417;
  --line: rgba(255,255,255,0.04);
  --line-strong: rgba(255,255,255,0.06);
  --text: #eef2f7;
  --muted: #9aa6b8;
  --subtle: #768096;
  --accent: #6b76ff; /* restrained accent */
  --accent-strong: #5770ff;
  --success: #5fc291;
  --warning: #e0b24f;
  --danger: #ff6b7a;
}

* {
  box-sizing: border-box;
}

html {
  background: var(--bg);
  scroll-behavior: smooth;
}

body {
  min-width: 320px;
  margin: 0;
  background:
    radial-gradient(circle at 50% -20%, rgba(91, 110, 255, 0.2), transparent 34rem),
    var(--bg);
  color: var(--text);
}

button,
textarea,
input {
  font: inherit;
}

button {
  border: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

.app {
  min-height: 100vh;
  overflow: hidden;
}

.header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: 1fr auto 220px;
  align-items: center;
  height: 74px;
  padding: 0 clamp(16px, 4vw, 48px);
  border-bottom: 1px solid var(--line);
  background: rgba(8, 11, 18, 0.82);
  backdrop-filter: blur(8px);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header-center {
  display: flex;
  justify-content: center;
}

.header-right {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
}

/* header action icons (removed for minimalist layout) */
.header-actions { display: none; }

.icon-btn { display: none; }

/* account control removed Ã¢â‚¬â€ keep CSS safe but hidden */
.account { display: none; }
.account-btn { display: none; }

/* agent card uplift styles removed to favor minimal list */
.agent-card { box-shadow: none; padding: 0; }

.agent-card__header { gap: 8px; }

.agent-name { font-size: 14px; }
.agent-status { color: var(--muted); font-size: 12px; }

/* activity timeline simplified */
.activity-card { padding: 12px 0; }
.activity-list { padding: 0; }
.activity-item { padding: 8px 0; border-radius: 0; margin-bottom: 6px; background: transparent; display:flex; gap:12px; align-items:center; border-bottom: 1px solid rgba(255,255,255,0.02); }
.activity-item--active { border-left: none; }
.activity-item--error { border-left: none; color: var(--danger); }

.activity-marker { width: 26px; height:26px; display:grid; place-items:center; border-radius:6px; background: transparent; color: var(--muted); }

.activity-text { font-weight:600; }
.activity-meta { color:var(--muted); font-size:12px; }

/* result header simplified */
.result-header { padding: 12px 0; border-radius: 0; }
.result-header-left { display:flex; gap:12px; align-items:center; }
.agent-avatar { width:48px; height:48px; border-radius:8px; display:grid; place-items:center; font-weight:700; font-size:16px; background: rgba(255,255,255,0.02); }

.result-message { color: var(--muted); margin-top:6px; }

.result-actions { align-items:center; }

/* execution panel styling simplified */
.execution-panel { padding: 8px 0; border-radius: 0; margin-top: 12px; border-bottom: 1px solid rgba(255,255,255,0.03); }

.research-panel { display:grid; grid-template-columns: 1fr 320px; gap: 18px; }

@media (max-width: 960px) {
  .research-panel { grid-template-columns: 1fr; }
}

/* Accessibility helpers */
.sr-only {
  position: absolute !important;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: absolute;
  left: 8px;
  top: 8px;
  background: rgba(255,255,255,0.02);
  color: var(--text);
  padding: 8px 10px;
  border-radius: 6px;
  z-index: 50;
  transform: translateY(-100%);
  transition: transform 140ms ease;
}

.skip-link:focus {
  transform: translateY(0);
  outline: none;
  box-shadow: 0 8px 30px rgba(0,0,0,0.6);
}

.run-button:focus-visible {
  outline: 2px solid rgba(87,112,255,0.18);
  outline-offset: 2px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
}

.brand-mark,
.agent-icon {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border: 1px solid rgba(165, 179, 255, 0.45);
  border-radius: 11px;
  background: linear-gradient(145deg, #9eacff, #6e7fff);
  box-shadow: 0 9px 22px rgba(69, 84, 220, 0.25);
  color: white;
  font-size: 15px;
  font-weight: 800;
}

.brand > span:last-child {
  display: grid;
  gap: 2px;
}

.brand strong {
  font-size: 17px;
  letter-spacing: 0.16em;
}

.brand small {
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.top-nav {
  display: flex;
  gap: 26px;
  color: var(--muted);
  font-size: 13px;
}

.top-nav a {
  transition: color 160ms ease;
}

.top-nav a:hover {
  color: var(--text);
}

.status,
.ready {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #b7c2d3;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.status {
  min-width: 156px;
  justify-content: flex-end;
}

.status-dot,
.ready i {
  display: block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 0 4px rgba(98, 217, 160, 0.1);
}

.main {
  width: min(1100px, calc(100% - 40px));
  margin: 0 auto;
  padding: 64px 0 56px;
}

.hero {
  max-width: 840px;
  margin: 36px auto 48px;
  text-align: left;
  padding: 24px 0;
}

.eyebrow,
.section-heading > span {
  color: var(--subtle);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.hero h1 {
  max-width: 760px;
  margin: 8px 0 8px;
  color: var(--text);
  font-size: clamp(28px, 3.4vw, 40px);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.08;
}

.hero p {
  max-width: 640px;
  margin: 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
}

.workspace,
.activity-card,
.results {
  border-bottom: 1px solid rgba(255,255,255,0.04);
  border-radius: 6px;
  background: transparent;
  box-shadow: none;
}

.workspace { padding: 0; }

.workspace {
  margin-top: 48px;
  padding: clamp(18px, 3.2vw, 28px);
}

.workspace-heading,
.result-header,
.section-heading--wide {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
}

.workspace-heading h2,
.result-header h2 {
  margin: 7px 0 0;
  font-size: clamp(23px, 3vw, 32px);
  font-weight: 650;
  letter-spacing: -0.04em;
}

.auto-route {
  display: flex;
  min-width: 224px;
  align-items: center;
  gap: 11px;
  padding: 11px 13px;
  border: 1px solid rgba(147, 161, 255, 0.23);
  border-radius: 12px;
  background: rgba(124, 141, 255, 0.08);
}

.auto-route > span {
  display: grid;
  width: 25px;
  height: 25px;
  place-items: center;
  border-radius: 8px;
  background: rgba(148, 163, 255, 0.18);
  color: #b6c0ff;
  font-weight: 700;
}

.auto-route strong,
.auto-route small {
  display: block;
}

.auto-route strong {
  color: #c2cbff;
  font-size: 10px;
  letter-spacing: 0.1em;
}

.auto-route small {
  margin-top: 3px;
  color: var(--muted);
  font-size: 10px;
}

.composer {
  margin-top: 18px;
  overflow: visible;
  border: 0;
  border-radius: 6px;
  background: transparent;
  padding: 8px 0 0 0;
}

.composer-top textarea {
  display: block;
  width: 100%;
  min-height: 180px;
  padding: 18px;
  resize: vertical;
  border: 1px solid rgba(255,255,255,0.04);
  outline: none;
  background: rgba(255,255,255,0.01);
  color: var(--text);
  font-size: 16px;
  line-height: 1.7;
  border-radius: 6px;
}

.composer-top textarea:focus {
  border-color: rgba(139,156,255,0.14);
  box-shadow: none;
}

.composer-top textarea::placeholder { color: #7b8799 }

.composer-footer { padding: 10px }

.upload { padding: 6px 10px; border-radius: 10px }

.upload .upload-label { margin-left: 6px }

.file-name { display: inline-flex; gap: 8px; align-items:center; color:var(--muted) }

.run-button { padding: 0 16px; min-height:40px }

.run-button .run-arrow { margin-left: 8px }

.composer:focus-within {
  border-color: rgba(138, 156, 255, 0.75);
  box-shadow: 0 0 0 4px rgba(124, 141, 255, 0.1);
}

textarea {
  display: block;
  width: 100%;
  min-height: 156px;
  padding: 20px;
  resize: vertical;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  font-size: 15px;
  line-height: 1.65;
}

textarea::placeholder {
  color: #6d788a;
}

.composer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 10px 0 0 0;
  border-top: 0;
  background: transparent;
}

.composer-actions { gap: 8px; }

.upload {
  padding: 6px 10px;
  border-radius: 6px;
  border: 1px solid rgba(255,255,255,0.03);
  color: var(--muted);
  background: transparent;
}

.clear-button {
  background: transparent;
  color: var(--muted);
  border: 0;
}

.run-button {
  padding: 10px 18px;
  border-radius: 8px;
  background: var(--accent-strong);
  color: white;
  font-weight: 700;
}

.run-button:disabled { opacity: 0.6; cursor: wait; }

.composer-actions {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10px;
}

.composer-actions--right {
  margin-left: auto;
}

.upload,
.clear-button,
.run-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 39px;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
}

.upload {
  padding: 0 12px;
  border: 1px solid var(--line-strong);
  color: #c4cedd;
}

.upload:hover,
.clear-button:hover {
  border-color: rgba(177, 191, 215, 0.4);
  background: rgba(255, 255, 255, 0.05);
}

.upload input {
  display: none;
}

.upload-icon {
  color: #b5c0ff;
  font-size: 17px;
  line-height: 1;
}

.file-name {
  display: inline-flex;
  min-width: 0;
  max-width: 260px;
  align-items: center;
  gap: 7px;
  overflow: hidden;
  color: var(--muted);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-name b {
  padding: 3px 5px;
  border: 1px solid rgba(97, 216, 170, 0.25);
  border-radius: 4px;
  background: rgba(97, 216, 170, 0.08);
  color: var(--success);
  font-size: 9px;
}

.clear-button {
  padding: 0 12px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--muted);
}

.run-button {
  padding: 10px 18px;
  border-radius: 8px;
  background: var(--accent);
  color: var(--text);
  font-weight: 700;
  border: 1px solid rgba(255,255,255,0.04);
  box-shadow: none;
}

.run-button:hover:not(:disabled) {
  filter: brightness(0.95);
  transform: translateY(-1px);
}

.run-button:hover:not(:disabled),
.upload:hover,
.clear-button:hover {
  transform: translateY(-1px);
}

.run-button:disabled,
.upload:has(input:disabled) {
  cursor: wait;
  opacity: 0.6;
}

.agents-section {
  margin-top: 82px;
}

.section-heading h3 {
  margin: 6px 0 8px;
  color: var(--text);
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.result-section {
  padding: 18px 0;
  border-bottom: 1px solid rgba(255,255,255,0.03);
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}

.section-heading--wide > p {
  max-width: 260px;
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.55;
  text-align: right;
}

.metric-grid,
.statistics-grid,
.model-grid,
.correlation-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.agent-list {
  display: flex;
  gap: 18px;
  padding: 10px 0;
  align-items: center;
}

.agent-item {
  display: inline-flex;
  gap: 10px;
  align-items: center;
  background: transparent;
  border: 0;
  padding: 8px 10px;
  cursor: pointer;
  border-radius: 6px;
}

.agent-item:hover,
.agent-item:focus {
  background: rgba(255,255,255,0.01);
  outline: none;
}

.agent-item:focus-visible {
  box-shadow: 0 0 0 3px rgba(87,112,255,0.10);
}

.agent-item__icon {
  display: inline-grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border-radius: 6px;
  background: rgba(255,255,255,0.02);
  color: var(--text);
  font-weight: 700;
}

.agent-item__meta strong { display:block; font-size:14px; }
.agent-item__meta small { color:var(--muted); font-size:12px; }

.agent-item--selected .agent-item__icon { background: rgba(139,156,255,0.12); }

.agent-card,
.metric-card,
.content-card,
.stat-card,
.model-card,
.correlation-card,
.source-card {
  border: 0;
  border-radius: 6px;
  background: transparent;
}

.agent-card {
  min-height: 140px;
  padding: 14px;
  transition: transform 140ms ease, border-color 140ms ease, background 140ms ease;
}

.agent-card:hover {
  border-color: rgba(255,255,255,0.03);
  background: transparent;
  transform: translateY(-1px);
}

/* Result action buttons */
.result-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

.action-btn {
  background: transparent;
  color: #cfe0ff;
  border: 1px solid rgba(255,255,255,0.06);
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 13px;
  cursor: pointer;
  transition: background 160ms ease, transform 120ms ease, box-shadow 160ms ease;
}

.action-btn:focus {
  outline: 2px solid rgba(146,161,255,0.28);
  outline-offset: 2px;
  box-shadow: 0 6px 20px rgba(111,126,255,0.12);
}

.action-btn:hover {
  background: linear-gradient(90deg, rgba(124,141,255,0.06), rgba(111,126,255,0.04));
  transform: translateY(-2px);
}

.action-toast {
  margin-left: 8px;
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 13px;
}

.action-toast--success {
  background: rgba(54, 96, 57, 0.08);
  color: #bfe7c2;
  border: 1px solid rgba(54,96,57,0.12);
}

.action-toast--error {
  background: rgba(96, 54, 57, 0.06);
  color: #ffd6d6;
  border: 1px solid rgba(96,54,57,0.12);
}

/* Execution / routing compact */
.execution-compact {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3px;
  color: var(--muted);
  font-size: 12px;
}
.execution-compact strong { font-weight: 700; color: var(--text); }
.execution-compact small { color: var(--subtle); font-size: 11px; }

.execution-panel {
  display: flex;
  gap: 18px;
  padding: 12px 14px;
  margin: 12px 0 0;
  border-radius: 12px;
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  border: 1px solid rgba(255,255,255,0.02);
}

.research-meta-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 12px;
}

.meta-card { padding: 12px; border-radius: 10px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.02); }

.validation-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 10px; }

.validation-item span { color: var(--muted); font-size: 12px; display: block; }

.validation-item strong { font-size: 15px; color: var(--text); margin-top: 4px; display: block; }

.agent-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.agent-icon {
  width: 31px;
  height: 31px;
  border-radius: 9px;
  font-size: 12px;
}

.ready {
  color: var(--success);
  font-size: 9px;
}

.ready i {
  width: 6px;
  height: 6px;
}

.agent-card h4,
.stat-card h4,
.model-card h4,
.source-card h4 {
  margin: 24px 0 8px;
  color: #eaf0f9;
  font-size: 16px;
  font-weight: 650;
}

.agent-card p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.error-banner,
.notice-banner {
  display: flex;
  gap: 12px;
  margin-top: 26px;
  padding: 16px;
  border: 1px solid rgba(255, 121, 137, 0.25);
  border-radius: 14px;
  background: rgba(255, 121, 137, 0.08);
}

.error-banner > span {
  display: grid;
  width: 23px;
  height: 23px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 7px;
  background: rgba(255, 121, 137, 0.18);
  color: var(--danger);
  font-size: 13px;
  font-weight: 800;
}

.error-banner strong {
  color: #ffd0d6;
  font-size: 13px;
}

.error-banner p {
  margin: 4px 0 0;
  color: #e7a8b1;
  font-size: 12px;
}

.activity-card {
  margin-top: 30px;
  padding: 26px;
}

.live-label {
  padding: 5px 8px;
  border: 1px solid rgba(142, 157, 255, 0.3);
  border-radius: 99px;
  background: rgba(135, 151, 255, 0.1);
  color: #b9c3ff;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.activity-list {
  display: grid;
  gap: 0;
  margin: 20px 0 0;
  padding: 0;
  list-style: none;
}

.activity-item {
  display: grid;
  grid-template-columns: 36px 1fr;
  align-items: center;
  min-height: 54px;
  padding: 8px 0;
  border-bottom: 1px solid var(--line);
  color: #c2cddb;
  font-size: 13px;
}

.activity-marker { width: 36px; height: 36px; border-radius: 8px; display:grid; place-items:center; font-size:14px }

.activity-body { display:flex; flex-direction:column; gap:6px }

.activity-text { color: #e6eefc; font-weight:700 }

.activity-meta { color: var(--subtle); font-size:11px; font-weight:800 }

.activity-item--active .activity-marker { border-radius:50%; box-shadow:none }

.activity-item:last-child {
  border-bottom: 0;
}

.activity-marker {
  display: grid;
  width: 18px;
  height: 18px;
  place-items: center;
  border: 1px solid #59657a;
  border-radius: 50%;
  color: var(--success);
  font-size: 11px;
}

.activity-item--done .activity-marker {
  border-color: rgba(98, 217, 160, 0.45);
  background: rgba(98, 217, 160, 0.1);
}

.activity-item--active .activity-marker {
  border-color: var(--accent);
  background: var(--accent);
  box-shadow: 0 0 0 4px rgba(139, 156, 255, 0.13);
  animation: pulse 1.4s infinite;
}

.activity-item--error .activity-marker {
  border-color: var(--danger);
  background: rgba(255, 121, 137, 0.1);
}

.activity-item small {
  color: var(--subtle);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.09em;
}

.activity-item--done small {
  color: var(--success);
}

.activity-item--active small {
  color: #adb9ff;
}

.activity-item--error small {
  color: var(--danger);
}

.results {
  margin-top: 30px;
  padding: clamp(22px, 4vw, 36px);
}

.result-header {
  padding-bottom: 22px;
  border-bottom: 1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
}

.result-header-left { display:flex; gap:12px; align-items:center }

.agent-avatar {
  width:56px; height:56px; border-radius:12px; display:grid; place-items:center; font-weight:800; color:#fff; background:linear-gradient(135deg,#7e8bff,#5c6fff); font-size:18px;
}

.result-message { color:var(--muted); margin-top:4px }

.result-header-right { display:flex; gap:12px; align-items:center }

.routing-compact { background: rgba(255,255,255,0.02); border:1px solid var(--line); padding:8px 10px; border-radius:10px; text-align:right }

.routing-compact small { display:block; color:var(--muted); font-size:11px }

.result-header p {
  max-width: 640px;
