}

/* Upload */
.orbit-v3 .upload-button,
.orbit-v3 .csv-upload,
.orbit-v3 .upload-label {
  min-height: 42px;
  padding: 0 14px;
  border: 1px solid #d0d0d0;
  background: #fff;
  color: #161616;
  border-radius: 0;
  font-size: 12px;
  cursor: pointer;
}

.orbit-v3 .upload-button:hover,
.orbit-v3 .csv-upload:hover,
.orbit-v3 .upload-label:hover {
  background: #f4f4f4;
}

/* Run */
.orbit-v3 .run-button {
  min-height: 44px;
  min-width: 145px;
  padding: 0 18px;
  border: 0;
  background: #0f62fe;
  color: #fff;
  border-radius: 0;
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.orbit-v3 .run-button:hover:not(:disabled) {
  background: #0043ce;
}

.orbit-v3 .run-button:disabled {
  opacity: .55;
  cursor: wait;
}

.orbit-v3 .run-arrow {
  font-size: 18px;
  line-height: 1;
}

/* Agent section */
.orbit-v3 .agents-section {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 48px 100px;
}

.orbit-v3 .agents-section .section-heading {
  margin-bottom: 28px;
}

.orbit-v3 .agents-section .section-heading h3 {
  margin-top: 8px;
  font-size: clamp(30px, 3vw, 46px);
  line-height: 1;
  letter-spacing: -.04em;
  font-weight: 500;
}

/* Responsive */
@media (max-width: 900px) {
  .orbit-v3 .workspace {
    padding: 44px 24px 70px;
  }

  .orbit-v3 .workspace-heading {
    display: block;
  }

  .orbit-v3 .composer-top {
    min-height: 220px;
    padding: 24px;
  }

  .orbit-v3 .composer textarea {
    min-height: 165px;
  }

  .orbit-v3 .composer-bottom {
    align-items: stretch;
    flex-direction: column;
  }

  .orbit-v3 .composer-actions,
  .orbit-v3 .composer-actions--left,
  .orbit-v3 .composer-actions--right {
    width: 100%;
  }

  .orbit-v3 .run-button {
    width: 100%;
  }

  .orbit-v3 .agents-section {
    padding-left: 24px;
    padding-right: 24px;
  }
}

@media (max-width: 600px) {
  .orbit-v3 .workspace {
    padding: 36px 18px 60px;
  }

  .orbit-v3 .composer-top {
    padding: 20px;
  }

  .orbit-v3 .composer textarea {
    font-size: 22px;
  }

  .orbit-v3 .agents-section {
    padding-left: 18px;
    padding-right: 18px;
  }
}
