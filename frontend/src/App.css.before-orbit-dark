/* ORBIT ENTERPRISE UI v2 */

:root {
  --orbit-blue: #0f62fe;
  --orbit-blue-dark: #0043ce;
  --orbit-ink: #161616;
  --orbit-muted: #525252;
  --orbit-border: #d0d0d0;
  --orbit-surface: #ffffff;
  --orbit-soft: #f4f4f4;
  --orbit-grid: rgba(15, 98, 254, 0.055);
  --orbit-success: #198038;
}

html {
  scroll-behavior: smooth;
  background: #fff;
}

body {
  margin: 0;
  background: #fff;
  color: var(--orbit-ink);
  font-family: Arial, Helvetica, sans-serif;
}

#root {
  width: 100%;
  max-width: none;
  min-height: 100vh;
  margin: 0;
  border: 0;
  text-align: left;
  display: block;
}

.app {
  width: 100%;
  min-height: 100vh;
  background: #fff;
  color: var(--orbit-ink);
}

/* ---------- HEADER ---------- */

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  height: 64px;
  padding: 0 32px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,0.97);
  border-top: 3px solid var(--orbit-ink);
  border-bottom: 1px solid var(--orbit-border);
  backdrop-filter: blur(10px);
}

.header-left {
  display: flex;
  align-items: center;
  min-width: 220px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--orbit-ink);
  text-decoration: none;
}

.brand strong {
  font-size: 24px;
  line-height: 1;
  letter-spacing: -1px;
  font-weight: 700;
}

.brand small {
  display: block;
  color: var(--orbit-muted);
  font-size: 11px;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.agent-icon {
  width: 32px;
  height: 32px;
  border: 1px solid var(--orbit-ink);
  display: grid;
  place-items: center;
  background: #fff;
  color: var(--orbit-blue);
  font-weight: 700;
}

.header-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.top-nav {
  display: flex;
  align-items: center;
  gap: 4px;
}

.top-nav a {
  padding: 22px 18px;
  color: var(--orbit-ink);
  text-decoration: none;
  font-size: 14px;
  border-bottom: 3px solid transparent;
  transition: .18s ease;
}

.top-nav a:hover {
  color: var(--orbit-blue);
  border-bottom-color: var(--orbit-blue);
  background: var(--orbit-soft);
}

.header-right {
  min-width: 180px;
  display: flex;
  justify-content: flex-end;
}

.ready {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--orbit-ink);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.ready i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--orbit-success);
  box-shadow: 0 0 0 4px rgba(25,128,56,.1);
}

/* ---------- MAIN ---------- */

.main {
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 540px;
  padding: 110px 7vw 90px;
  box-sizing: border-box;
  background:
    linear-gradient(90deg, transparent 0 9%, var(--orbit-grid) 9% 9.1%, transparent 9.1% 100%),
    linear-gradient(0deg, transparent 0 19%, var(--orbit-grid) 19% 19.1%, transparent 19.1% 100%),
    #fff;
  border-bottom: 1px solid var(--orbit-border);
}

.hero::after {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  right: -150px;
  top: -180px;
  background: linear-gradient(135deg, rgba(15,98,254,.12), rgba(120,70,255,.08));
  transform: rotate(12deg);
  pointer-events: none;
}

.hero > * {
  position: relative;
  z-index: 1;
}

.section-heading > span,
.eyebrow {
  color: var(--orbit-blue);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.hero h1 {
  max-width: 850px;
  margin: 22px 0 24px;
  color: var(--orbit-ink);
  font-size: clamp(52px, 7vw, 92px);
  line-height: .98;
  letter-spacing: -4px;
  font-weight: 400;
}

.hero p {
  max-width: 680px;
  color: var(--orbit-muted);
  font-size: 19px;
  line-height: 1.55;
}

/* ---------- SECTIONS ---------- */

.workspace,
.agents-section,
.result-section,
.results {
  max-width: 1280px;
  margin: 0 auto;
  padding: 80px 7vw;
  box-sizing: border-box;
}

.section-heading {
  margin-bottom: 34px;
}

.section-heading h3 {
  margin: 8px 0;
  color: var(--orbit-ink);
  font-size: 38px;
  line-height: 1.1;
  font-weight: 400;
  letter-spacing: -1.5px;
}

.section-heading--wide > p {
  max-width: 650px;
  color: var(--orbit-muted);
}

/* ---------- WORKSPACE ---------- */

.workspace {
  background: #fff;
}

.auto-route {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 0;
  margin-bottom: 18px;
  color: var(--orbit-muted);
  border-top: 1px solid var(--orbit-border);
  border-bottom: 1px solid var(--orbit-border);
}

.auto-route strong {
  color: var(--orbit-ink);
}

.auto-route small {
  color: var(--orbit-muted);
}

.composer {
  background: #fff;
  border: 1px solid var(--orbit-ink);
  border-radius: 0;
  box-shadow: 8px 8px 0 var(--orbit-blue);
  transition: box-shadow .2s ease;
}

.composer:focus-within {
  border-color: var(--orbit-blue);
  box-shadow: 10px 10px 0 var(--orbit-blue);
}

.composer-top textarea,
textarea {
  width: 100%;
  min-height: 150px;
  padding: 24px;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  resize: vertical;
  outline: 0;
  color: var(--orbit-ink);
  background: #fff;
  font-size: 18px;
  line-height: 1.55;
}

.composer-top textarea::placeholder {
  color: #8d8d8d;
}

.composer-footer {
  min-height: 62px;
  padding: 10px 14px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--orbit-border);
}

.composer-actions {
  gap: 10px;
}

.upload,
.clear-button,
.run-button,
.action-btn {
  border-radius: 0;
  font-weight: 600;
  transition: .18s ease;
}

.upload {
  border: 1px solid var(--orbit-border);
  background: #fff;
  color: var(--orbit-ink);
}

.upload:hover {
  border-color: var(--orbit-blue);
  color: var(--orbit-blue);
}

.clear-button {
  border: 0;
  background: transparent;
  color: var(--orbit-muted);
}

.clear-button:hover {
  color: var(--orbit-blue);
}

.run-button {
  min-height: 44px;
  padding: 0 24px;
  border: 0;
  background: var(--orbit-blue);
  color: #fff;
}

.run-button:hover:not(:disabled) {
  background: var(--orbit-blue-dark);
  transform: translateY(-1px);
}

.run-button .run-arrow {
  margin-left: 14px;
}

/* ---------- AGENTS ---------- */

.agents-section {
  background: var(--orbit-soft);
  max-width: none;
  padding-left: max(7vw, calc((100% - 1280px) / 2));
  padding-right: max(7vw, calc((100% - 1280px) / 2));
}

.agent-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border-top: 1px solid var(--orbit-ink);
  border-bottom: 1px solid var(--orbit-ink);
}

.agent-item {
  min-height: 220px;
  padding: 28px;
  display: flex;
  align-items: flex-start;
  gap: 22px;
  text-align: left;
  border: 0;
  border-right: 1px solid var(--orbit-border);
  border-radius: 0;
  background: #fff;
  color: var(--orbit-ink);
  cursor: pointer;
  transition: .2s ease;
}

.agent-item:last-child {
  border-right: 0;
}

.agent-item:hover,
.agent-item--selected {
  background: var(--orbit-blue);
  color: #fff;
}

.agent-item__icon {
  flex: 0 0 auto;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 0;
  border: 1px solid currentColor;
  background: transparent;
  font-weight: 700;
}

.agent-item__meta strong {
  display: block;
  margin-bottom: 10px;
  font-size: 21px;
  font-weight: 500;
}

.agent-item__meta small {
  color: var(--orbit-muted);
  font-size: 14px;
  line-height: 1.5;
}

.agent-item:hover .agent-item__meta small,
.agent-item--selected .agent-item__meta small {
  color: rgba(255,255,255,.8);
}

/* ---------- ACTIVITY ---------- */

.activity-card {
  background: #fff;
  border: 1px solid var(--orbit-border);
  border-radius: 0;
  box-shadow: none;
}

.activity-list {
  padding: 0;
}

.activity-item {
  min-height: 58px;
  margin: 0;
  padding: 12px 18px;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 38px 1fr auto;
  align-items: center;
  gap: 14px;
  border-radius: 0;
  border-bottom: 1px solid var(--orbit-border);
  background: #fff;
}

.activity-item:last-child {
  border-bottom: 0;
}

.activity-marker {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--orbit-soft);
  color: var(--orbit-blue);
  border: 1px solid var(--orbit-border);
}

.activity-text {
  color: var(--orbit-ink);
  font-weight: 600;
}

.activity-meta {
  color: var(--orbit-muted);
  font-size: 12px;
}

/* ---------- RESULTS ---------- */

.results {
  max-width: 1280px;
  background: #fff;
}

.result-header {
  padding: 30px 0;
  border-radius: 0;
  border-top: 2px solid var(--orbit-ink);
  border-bottom: 1px solid var(--orbit-border);
}

.result-header-left {
  display: flex;
  gap: 18px;
  align-items: center;
}

.agent-avatar {
  width: 56px;
  height: 56px;
  border-radius: 0;
  display: grid;
  place-items: center;
  background: var(--orbit-blue);
  color: #fff;
  font-weight: 700;
  font-size: 17px;
}

.result-header h2 {
  margin: 4px 0;
  color: var(--orbit-ink);
  font-size: 34px;
  font-weight: 400;
  letter-spacing: -1px;
}

.result-provider {
  margin-top: 5px;
  color: var(--orbit-blue);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .02em;
}

.status-pill {
  border-radius: 0;
  border: 1px solid var(--orbit-success);
  background: #fff;
  color: var(--orbit-success);
}

.execution-compact {
  border-radius: 0;
  background: var(--orbit-soft);
  border: 1px solid var(--orbit-border);
  color: var(--orbit-ink);
}

.execution-panel {
  margin-top: 0;
  padding: 22px 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border-radius: 0;
  border-bottom: 1px solid var(--orbit-border);
}

.execution-panel > div {
  padding: 8px 22px;
  border-left: 3px solid var(--orbit-blue);
}

.execution-panel > div + div {
  border-left: 1px solid var(--orbit-border);
}

.execution-panel span {
  display: block;
  margin-bottom: 6px;
  color: var(--orbit-muted);
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.execution-panel strong {
  color: var(--orbit-ink);
  font-size: 15px;
}

.result-content {
  margin-top: 34px;
}

.result-content h3 {
  color: var(--orbit-ink);
  font-size: 22px;
  font-weight: 500;
}

.result-content pre,
.result-content .response,
.result-content > div {
  border-radius: 0;
}

.action-btn {
  min-height: 38px;
  padding: 0 14px;
  border: 1px solid var(--orbit-border);
  background: #fff;
  color: var(--orbit-ink);
}

.action-btn:hover {
  border-color: var(--orbit-blue);
  color: var(--orbit-blue);
  background: #f8fbff;
}

/* ---------- RESEARCH / DATA / ML ---------- */

.research-panel {
  border-top: 1px solid var(--orbit-border);
}

.source-card,
.agent-card {
  border-radius: 0;
  border: 1px solid var(--orbit-border);
  background: #fff;
  box-shadow: none;
}

.agent-card:hover {
  border-color: var(--orbit-blue);
  transform: none;
}

/* ---------- FOOTER / LOWER UI ---------- */

.app a {
  color: var(--orbit-blue);
}

.app button:focus-visible,
.app a:focus-visible,
.app textarea:focus-visible,
.app input:focus-visible {
  outline: 2px solid var(--orbit-blue);
  outline-offset: 3px;
}

/* ---------- RESPONSIVE ---------- */

@media (max-width: 900px) {
  .header {
    padding: 0 18px;
  }

  .header-center {
    display: none;
  }

  .header-left {
    min-width: auto;
  }

  .header-right {
    min-width: auto;
  }

  .hero {
    min-height: auto;
    padding: 80px 24px 70px;
  }

  .hero h1 {
    font-size: clamp(46px, 11vw, 72px);
    letter-spacing: -2.5px;
  }

  .workspace,
  .result-section,
  .results {
    padding: 60px 24px;
  }

  .agents-section {
    padding: 60px 24px;
  }

  .agent-list {
    grid-template-columns: 1fr;
  }

  .agent-item {
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid var(--orbit-border);
  }

  .agent-item:last-child {
    border-bottom: 0;
  }
}

@media (max-width: 600px) {
  .header {
    height: 58px;
  }

  .brand small {
    display: none;
  }

  .hero h1 {
    font-size: 48px;
  }

  .hero p {
    font-size: 16px;
  }

  .section-heading h3 {
    font-size: 30px;
  }

  .composer {
    box-shadow: 5px 5px 0 var(--orbit-blue);
  }

  .composer-footer {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }

  .composer-actions,
  .composer-actions--right {
    width: 100%;
    justify-content: space-between;
  }

  .run-button {
    flex: 1;
  }

  .result-header-left {
    align-items: flex-start;
  }

  .result-header h2 {
    font-size: 27px;
  }

  .execution-panel {
    grid-template-columns: 1fr;
  }

  .execution-panel > div + div {
    border-left: 3px solid var(--orbit-blue);
    border-top: 1px solid var(--orbit-border);
  }
