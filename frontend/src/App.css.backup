:root {
  --bg: #0b0e14;
  --panel: #0f1419;
  --panel-soft: #0c1114;
  --panel-raised: #111417;
  --line: rgba(255,255,255,0.04);
  --line-strong: rgba(255,255,255,0.06);
  --text: #eef2f7;
  --muted: #9aa6b8;
  --subtle: #768096;
  --accent: #6b76ff; /* restrained accent */
  --accent-strong: #5770ff;
  --success: #5fc291;
  --warning: #e0b24f;
  --danger: #ff6b7a;
}

* {
  box-sizing: border-box;
}

html {
  background: var(--bg);
  scroll-behavior: smooth;
}

body {
  min-width: 320px;
  margin: 0;
  background:
    radial-gradient(circle at 50% -20%, rgba(91, 110, 255, 0.2), transparent 34rem),
    var(--bg);
  color: var(--text);
}

button,
textarea,
input {
  font: inherit;
}

button {
  border: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

.app {
  min-height: 100vh;
  overflow: hidden;
}

.header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: 1fr auto 220px;
  align-items: center;
  height: 74px;
  padding: 0 clamp(16px, 4vw, 48px);
  border-bottom: 1px solid var(--line);
  background: rgba(8, 11, 18, 0.82);
  backdrop-filter: blur(8px);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header-center {
  display: flex;
  justify-content: center;
}

.header-right {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
}

/* header action icons (removed for minimalist layout) */
.header-actions { display: none; }

.icon-btn { display: none; }

/* account control removed â€” keep CSS safe but hidden */
.account { display: none; }
.account-btn { display: none; }

/* agent card uplift styles removed to favor minimal list */
.agent-card { box-shadow: none; padding: 0; }

.agent-card__header { gap: 8px; }

.agent-name { font-size: 14px; }
.agent-status { color: var(--muted); font-size: 12px; }

/* activity timeline simplified */
.activity-card { padding: 12px 0; }
.activity-list { padding: 0; }
.activity-item { padding: 8px 0; border-radius: 0; margin-bottom: 6px; background: transparent; display:flex; gap:12px; align-items:center; border-bottom: 1px solid rgba(255,255,255,0.02); }
.activity-item--active { border-left: none; }
.activity-item--error { border-left: none; color: var(--danger); }

.activity-marker { width: 26px; height:26px; display:grid; place-items:center; border-radius:6px; background: transparent; color: var(--muted); }

.activity-text { font-weight:600; }
.activity-meta { color:var(--muted); font-size:12px; }

/* result header simplified */
.result-header { padding: 12px 0; border-radius: 0; }
.result-header-left { display:flex; gap:12px; align-items:center; }
.agent-avatar { width:48px; height:48px; border-radius:8px; display:grid; place-items:center; font-weight:700; font-size:16px; background: rgba(255,255,255,0.02); }

.result-message { color: var(--muted); margin-top:6px; }

.result-actions { align-items:center; }

/* execution panel styling simplified */
.execution-panel { padding: 8px 0; border-radius: 0; margin-top: 12px; border-bottom: 1px solid rgba(255,255,255,0.03); }

.research-panel { display:grid; grid-template-columns: 1fr 320px; gap: 18px; }

@media (max-width: 960px) {
  .research-panel { grid-template-columns: 1fr; }
}

/* Accessibility helpers */
.sr-only {
  position: absolute !important;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: absolute;
  left: 8px;
  top: 8px;
  background: rgba(255,255,255,0.02);
  color: var(--text);
  padding: 8px 10px;
  border-radius: 6px;
  z-index: 50;
  transform: translateY(-100%);
  transition: transform 140ms ease;
}

.skip-link:focus {
  transform: translateY(0);
  outline: none;
  box-shadow: 0 8px 30px rgba(0,0,0,0.6);
}

.run-button:focus-visible {
  outline: 2px solid rgba(87,112,255,0.18);
  outline-offset: 2px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
}

.brand-mark,
.agent-icon {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border: 1px solid rgba(165, 179, 255, 0.45);
  border-radius: 11px;
  background: linear-gradient(145deg, #9eacff, #6e7fff);
  box-shadow: 0 9px 22px rgba(69, 84, 220, 0.25);
  color: white;
  font-size: 15px;
  font-weight: 800;
}

.brand > span:last-child {
  display: grid;
  gap: 2px;
}

.brand strong {
  font-size: 17px;
  letter-spacing: 0.16em;
}

.brand small {
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.top-nav {
  display: flex;
  gap: 26px;
  color: var(--muted);
  font-size: 13px;
}

.top-nav a {
  transition: color 160ms ease;
}

.top-nav a:hover {
  color: var(--text);
}

.status,
.ready {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #b7c2d3;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.status {
  min-width: 156px;
  justify-content: flex-end;
}

.status-dot,
.ready i {
  display: block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 0 4px rgba(98, 217, 160, 0.1);
}

.main {
  width: min(1100px, calc(100% - 40px));
  margin: 0 auto;
  padding: 64px 0 56px;
}

.hero {
  max-width: 840px;
  margin: 36px auto 48px;
  text-align: left;
  padding: 24px 0;
}

.eyebrow,
.section-heading > span {
  color: var(--subtle);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.hero h1 {
  max-width: 760px;
  margin: 8px 0 8px;
  color: var(--text);
  font-size: clamp(28px, 3.4vw, 40px);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.08;
}

.hero p {
  max-width: 640px;
  margin: 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
}

.workspace,
.activity-card,
.results {
  border-bottom: 1px solid rgba(255,255,255,0.04);
  border-radius: 6px;
  background: transparent;
  box-shadow: none;
}

.workspace { padding: 0; }

.workspace {
  margin-top: 48px;
  padding: clamp(18px, 3.2vw, 28px);
}

.workspace-heading,
.result-header,
.section-heading--wide {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
}

.workspace-heading h2,
.result-header h2 {
  margin: 7px 0 0;
  font-size: clamp(23px, 3vw, 32px);
  font-weight: 650;
  letter-spacing: -0.04em;
}

.auto-route {
  display: flex;
  min-width: 224px;
  align-items: center;
  gap: 11px;
  padding: 11px 13px;
  border: 1px solid rgba(147, 161, 255, 0.23);
  border-radius: 12px;
  background: rgba(124, 141, 255, 0.08);
}

.auto-route > span {
  display: grid;
  width: 25px;
  height: 25px;
  place-items: center;
  border-radius: 8px;
  background: rgba(148, 163, 255, 0.18);
  color: #b6c0ff;
  font-weight: 700;
}

.auto-route strong,
.auto-route small {
  display: block;
}

.auto-route strong {
  color: #c2cbff;
  font-size: 10px;
  letter-spacing: 0.1em;
}

.auto-route small {
  margin-top: 3px;
  color: var(--muted);
  font-size: 10px;
}

.composer {
  margin-top: 18px;
  overflow: visible;
  border: 0;
  border-radius: 6px;
  background: transparent;
  padding: 8px 0 0 0;
}

.composer-top textarea {
  display: block;
  width: 100%;
  min-height: 180px;
  padding: 18px;
  resize: vertical;
  border: 1px solid rgba(255,255,255,0.04);
  outline: none;
  background: rgba(255,255,255,0.01);
  color: var(--text);
  font-size: 16px;
  line-height: 1.7;
  border-radius: 6px;
}

.composer-top textarea:focus {
  border-color: rgba(139,156,255,0.14);
  box-shadow: none;
}

.composer-top textarea::placeholder { color: #7b8799 }

.composer-footer { padding: 10px }

.upload { padding: 6px 10px; border-radius: 10px }

.upload .upload-label { margin-left: 6px }

.file-name { display: inline-flex; gap: 8px; align-items:center; color:var(--muted) }

.run-button { padding: 0 16px; min-height:40px }

.run-button .run-arrow { margin-left: 8px }

.composer:focus-within {
  border-color: rgba(138, 156, 255, 0.75);
  box-shadow: 0 0 0 4px rgba(124, 141, 255, 0.1);
}

textarea {
  display: block;
  width: 100%;
  min-height: 156px;
  padding: 20px;
  resize: vertical;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  font-size: 15px;
  line-height: 1.65;
}

textarea::placeholder {
  color: #6d788a;
}

.composer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 10px 0 0 0;
  border-top: 0;
  background: transparent;
}

.composer-actions { gap: 8px; }

.upload {
  padding: 6px 10px;
  border-radius: 6px;
  border: 1px solid rgba(255,255,255,0.03);
  color: var(--muted);
  background: transparent;
}

.clear-button {
  background: transparent;
  color: var(--muted);
  border: 0;
}

.run-button {
  padding: 10px 18px;
  border-radius: 8px;
  background: var(--accent-strong);
  color: white;
  font-weight: 700;
}

.run-button:disabled { opacity: 0.6; cursor: wait; }

.composer-actions {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10px;
}

.composer-actions--right {
  margin-left: auto;
}

.upload,
.clear-button,
.run-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 39px;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
}

.upload {
  padding: 0 12px;
  border: 1px solid var(--line-strong);
  color: #c4cedd;
}

.upload:hover,
.clear-button:hover {
  border-color: rgba(177, 191, 215, 0.4);
  background: rgba(255, 255, 255, 0.05);
}

.upload input {
  display: none;
}

.upload-icon {
  color: #b5c0ff;
  font-size: 17px;
  line-height: 1;
}

.file-name {
  display: inline-flex;
  min-width: 0;
  max-width: 260px;
  align-items: center;
  gap: 7px;
  overflow: hidden;
  color: var(--muted);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-name b {
  padding: 3px 5px;
  border: 1px solid rgba(97, 216, 170, 0.25);
  border-radius: 4px;
  background: rgba(97, 216, 170, 0.08);
  color: var(--success);
  font-size: 9px;
}

.clear-button {
  padding: 0 12px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--muted);
}

.run-button {
  padding: 10px 18px;
  border-radius: 8px;
  background: var(--accent);
  color: var(--text);
  font-weight: 700;
  border: 1px solid rgba(255,255,255,0.04);
  box-shadow: none;
}

.run-button:hover:not(:disabled) {
  filter: brightness(0.95);
  transform: translateY(-1px);
}

.run-button:hover:not(:disabled),
.upload:hover,
.clear-button:hover {
  transform: translateY(-1px);
}

.run-button:disabled,
.upload:has(input:disabled) {
  cursor: wait;
  opacity: 0.6;
}

.agents-section {
  margin-top: 82px;
}

.section-heading h3 {
  margin: 6px 0 8px;
  color: var(--text);
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.result-section {
  padding: 18px 0;
  border-bottom: 1px solid rgba(255,255,255,0.03);
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}

.section-heading--wide > p {
  max-width: 260px;
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.55;
  text-align: right;
}

.metric-grid,
.statistics-grid,
.model-grid,
.correlation-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.agent-list {
  display: flex;
  gap: 18px;
  padding: 10px 0;
  align-items: center;
}

.agent-item {
  display: inline-flex;
  gap: 10px;
  align-items: center;
  background: transparent;
  border: 0;
  padding: 8px 10px;
  cursor: pointer;
  border-radius: 6px;
}

.agent-item:hover,
.agent-item:focus {
  background: rgba(255,255,255,0.01);
  outline: none;
}

.agent-item:focus-visible {
  box-shadow: 0 0 0 3px rgba(87,112,255,0.10);
}

.agent-item__icon {
  display: inline-grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border-radius: 6px;
  background: rgba(255,255,255,0.02);
  color: var(--text);
  font-weight: 700;
}

.agent-item__meta strong { display:block; font-size:14px; }
.agent-item__meta small { color:var(--muted); font-size:12px; }

.agent-item--selected .agent-item__icon { background: rgba(139,156,255,0.12); }

.agent-card,
.metric-card,
.content-card,
.stat-card,
.model-card,
.correlation-card,
.source-card {
  border: 0;
  border-radius: 6px;
  background: transparent;
}

.agent-card {
  min-height: 140px;
  padding: 14px;
  transition: transform 140ms ease, border-color 140ms ease, background 140ms ease;
}

.agent-card:hover {
  border-color: rgba(255,255,255,0.03);
  background: transparent;
  transform: translateY(-1px);
}

/* Result action buttons */
.result-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

.action-btn {
  background: transparent;
  color: #cfe0ff;
  border: 1px solid rgba(255,255,255,0.06);
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 13px;
  cursor: pointer;
  transition: background 160ms ease, transform 120ms ease, box-shadow 160ms ease;
}

.action-btn:focus {
  outline: 2px solid rgba(146,161,255,0.28);
  outline-offset: 2px;
  box-shadow: 0 6px 20px rgba(111,126,255,0.12);
}

.action-btn:hover {
  background: linear-gradient(90deg, rgba(124,141,255,0.06), rgba(111,126,255,0.04));
  transform: translateY(-2px);
}

.action-toast {
  margin-left: 8px;
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 13px;
}

.action-toast--success {
  background: rgba(54, 96, 57, 0.08);
  color: #bfe7c2;
  border: 1px solid rgba(54,96,57,0.12);
}

.action-toast--error {
  background: rgba(96, 54, 57, 0.06);
  color: #ffd6d6;
  border: 1px solid rgba(96,54,57,0.12);
}

/* Execution / routing compact */
.execution-compact {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3px;
  color: var(--muted);
  font-size: 12px;
}
.execution-compact strong { font-weight: 700; color: var(--text); }
.execution-compact small { color: var(--subtle); font-size: 11px; }

.execution-panel {
  display: flex;
  gap: 18px;
  padding: 12px 14px;
  margin: 12px 0 0;
  border-radius: 12px;
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  border: 1px solid rgba(255,255,255,0.02);
}

.research-meta-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 12px;
}

.meta-card { padding: 12px; border-radius: 10px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.02); }

.validation-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 10px; }

.validation-item span { color: var(--muted); font-size: 12px; display: block; }

.validation-item strong { font-size: 15px; color: var(--text); margin-top: 4px; display: block; }

.agent-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.agent-icon {
  width: 31px;
  height: 31px;
  border-radius: 9px;
  font-size: 12px;
}

.ready {
  color: var(--success);
  font-size: 9px;
}

.ready i {
  width: 6px;
  height: 6px;
}

.agent-card h4,
.stat-card h4,
.model-card h4,
.source-card h4 {
  margin: 24px 0 8px;
  color: #eaf0f9;
  font-size: 16px;
  font-weight: 650;
}

.agent-card p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.error-banner,
.notice-banner {
  display: flex;
  gap: 12px;
  margin-top: 26px;
  padding: 16px;
  border: 1px solid rgba(255, 121, 137, 0.25);
  border-radius: 14px;
  background: rgba(255, 121, 137, 0.08);
}

.error-banner > span {
  display: grid;
  width: 23px;
  height: 23px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 7px;
  background: rgba(255, 121, 137, 0.18);
  color: var(--danger);
  font-size: 13px;
  font-weight: 800;
}

.error-banner strong {
  color: #ffd0d6;
  font-size: 13px;
}

.error-banner p {
  margin: 4px 0 0;
  color: #e7a8b1;
  font-size: 12px;
}

.activity-card {
  margin-top: 30px;
  padding: 26px;
}

.live-label {
  padding: 5px 8px;
  border: 1px solid rgba(142, 157, 255, 0.3);
  border-radius: 99px;
  background: rgba(135, 151, 255, 0.1);
  color: #b9c3ff;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.activity-list {
  display: grid;
  gap: 0;
  margin: 20px 0 0;
  padding: 0;
  list-style: none;
}

.activity-item {
  display: grid;
  grid-template-columns: 36px 1fr;
  align-items: center;
  min-height: 54px;
  padding: 8px 0;
  border-bottom: 1px solid var(--line);
  color: #c2cddb;
  font-size: 13px;
}

.activity-marker { width: 36px; height: 36px; border-radius: 8px; display:grid; place-items:center; font-size:14px }

.activity-body { display:flex; flex-direction:column; gap:6px }

.activity-text { color: #e6eefc; font-weight:700 }

.activity-meta { color: var(--subtle); font-size:11px; font-weight:800 }

.activity-item--active .activity-marker { border-radius:50%; box-shadow:none }

.activity-item:last-child {
  border-bottom: 0;
}

.activity-marker {
  display: grid;
  width: 18px;
  height: 18px;
  place-items: center;
  border: 1px solid #59657a;
  border-radius: 50%;
  color: var(--success);
  font-size: 11px;
}

.activity-item--done .activity-marker {
  border-color: rgba(98, 217, 160, 0.45);
  background: rgba(98, 217, 160, 0.1);
}

.activity-item--active .activity-marker {
  border-color: var(--accent);
  background: var(--accent);
  box-shadow: 0 0 0 4px rgba(139, 156, 255, 0.13);
  animation: pulse 1.4s infinite;
}

.activity-item--error .activity-marker {
  border-color: var(--danger);
  background: rgba(255, 121, 137, 0.1);
}

.activity-item small {
  color: var(--subtle);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.09em;
}

.activity-item--done small {
  color: var(--success);
}

.activity-item--active small {
  color: #adb9ff;
}

.activity-item--error small {
  color: var(--danger);
}

.results {
  margin-top: 30px;
  padding: clamp(22px, 4vw, 36px);
}

.result-header {
  padding-bottom: 22px;
  border-bottom: 1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
}

.result-header-left { display:flex; gap:12px; align-items:center }

.agent-avatar {
  width:56px; height:56px; border-radius:12px; display:grid; place-items:center; font-weight:800; color:#fff; background:linear-gradient(135deg,#7e8bff,#5c6fff); font-size:18px;
}

.result-message { color:var(--muted); margin-top:4px }

.result-header-right { display:flex; gap:12px; align-items:center }

.routing-compact { background: rgba(255,255,255,0.02); border:1px solid var(--line); padding:8px 10px; border-radius:10px; text-align:right }

.routing-compact small { display:block; color:var(--muted); font-size:11px }

.result-header p {
  max-width: 640px;
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 2px;
  padding: 8px 10px;
  border-radius: 99px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.status-pill i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.status-pill--success {
  background: rgba(98, 217, 160, 0.1);
  color: var(--success);
}

.status-pill--success i {
  background: var(--success);
}

.status-pill--warning {
  background: rgba(240, 188, 104, 0.1);
  color: var(--warning);
}

.status-pill--warning i {
  background: var(--warning);
}

.status-pill--error {
  background: rgba(255, 121, 137, 0.1);
  color: var(--danger);
}

.status-pill--error i {
  background: var(--danger);
}

.routing-panel {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 22px;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: rgba(4, 8, 14, 0.28);
}

.routing-panel > div {
  min-height: 74px;
  padding: 16px 20px;
  border-right: 1px solid var(--line);
}

.routing-panel > div:last-child {
  border-right: 0;
}

.routing-panel span,
.metric-card span,
.content-card > span,
.prediction-card > div > span,
.prediction-input > span,
.model-metrics span {
  display: block;
  color: var(--subtle);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.11em;
}

.routing-panel strong {
  display: block;
  margin-top: 7px;
  color: #dfe7f3;
  font-size: 13px;
  font-weight: 650;
}

.result-content {
  display: grid;
  gap: 22px;
  margin-top: 28px;
}

.section-heading {
  margin-bottom: 12px;
}

.section-heading h3 {
  font-size: 18px;
}

.metric-grid {
  grid-template-columns: repeat(4, 1fr);
}

.metric-card {
  min-width: 0;
  padding: 12px;
}

.metric-card strong {
  display: block;
  margin-top: 6px;
  overflow-wrap: anywhere;
  color: #edf3fc;
  font-size: 15px;
  font-weight: 650;
  line-height: 1.28;
}

.schema-grid,
.split-sections,
.prediction-card {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}

.content-card,
.stat-card {
  padding: 18px;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 14px;
}

.tag {
  padding: 5px 8px;
  border: 1px solid rgba(143, 157, 255, 0.23);
  border-radius: 6px;
  background: rgba(133, 148, 255, 0.1);
  color: #bdc6ff;
  font-size: 11px;
  font-weight: 600;
}

.tag--neutral {
  border-color: rgba(183, 196, 216, 0.17);
  background: rgba(183, 196, 216, 0.06);
  color: #bcc7d8;
}

.tag-list em {
  color: var(--subtle);
  font-size: 12px;
  font-style: normal;
}

.statistic-grid,
.statistics-grid {
  grid-template-columns: repeat(3, 1fr);
}

.stat-card h4,
.model-card h4,
.source-card h4 {
  margin: 0;
}

.stat-card dl {
  display: grid;
  gap: 9px;
  margin: 16px 0 0;
}

.profile-chart,
.relationship-visual,
.empty-panel {
  margin-bottom: 18px;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(12, 18, 30, 0.7);
}

.chart-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 16px;
  margin-bottom: 6px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.chart-legend span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.chart-caption {
  margin: 0 0 16px;
  color: var(--subtle);
  font-size: 11px;
  line-height: 1.5;
}

.legend-swatch {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 3px;
}

.legend-swatch--min {
  background: rgba(130, 149, 255, 0.7);
}

.legend-swatch--mean {
  background: rgba(98, 217, 160, 0.8);
}

.legend-swatch--max {
  background: rgba(240, 188, 104, 0.8);
}

.profile-chart__body {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 16px;
}

.profile-column {
  display: grid;
  gap: 12px;
  min-height: 170px;
  padding: 12px 10px 8px;
  border: 1px solid rgba(179, 194, 220, 0.08);
  border-radius: 10px;
  background: rgba(17, 24, 37, 0.8);
}

.profile-column__label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
  color: #dae4f4;
  font-size: 11px;
  font-weight: 700;
}

.profile-column__label small,
.profile-column__meta {
  color: var(--muted);
  font-size: 10px;
}

.profile-bars {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  height: 88px;
  padding: 10px 8px 0;
  border-bottom: 1px solid rgba(179, 194, 220, 0.08);
}

.profile-bar {
  display: block;
  width: 100%;
  min-height: 12px;
  border-radius: 8px 8px 0 0;
}

.profile-bar--min {
  background: linear-gradient(180deg, rgba(130, 149, 255, 0.9), rgba(130, 149, 255, 0.45));
}

.profile-bar--mean {
  background: linear-gradient(180deg, rgba(98, 217, 160, 0.9), rgba(98, 217, 160, 0.45));
}

.profile-bar--max {
  background: linear-gradient(180deg, rgba(240, 188, 104, 0.9), rgba(240, 188, 104, 0.45));
}

.profile-column__meta {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}

.relationship-visual {
  display: grid;
  gap: 12px;
}

.correlation-row {
  display: grid;
  grid-template-columns: minmax(120px, 1.1fr) minmax(160px, 2.5fr) minmax(78px, auto);
  align-items: center;
  gap: 12px;
}

.correlation-row__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  color: #dfe8f7;
  font-size: 12px;
}

.correlation-row__label strong {
  color: #a9b8ff;
  font-size: 11px;
}

.correlation-bar-track {
  position: relative;
  height: 10px;
  overflow: hidden;
  border: 1px solid rgba(164, 178, 215, 0.14);
  border-radius: 999px;
  background: rgba(183, 196, 216, 0.08);
}

.correlation-bar-track i {
  display: block;
  height: 100%;
  border-radius: inherit;
}

.correlation-bar-track i.positive,
.positive {
  background: linear-gradient(90deg, rgba(98, 217, 160, 0.9), rgba(98, 217, 160, 0.5));
}

.correlation-bar-track i.negative,
.negative {
  background: linear-gradient(90deg, rgba(255, 121, 137, 0.85), rgba(255, 121, 137, 0.45));
}

.correlation-row small {
  min-width: 78px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
}

.empty-panel {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.stat-card dl div,
.missing-list div,
.prediction-input div {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.stat-card dt,
.stat-card dd {
  margin: 0;
  font-size: 12px;
}

.stat-card dt {
  color: var(--muted);
}

.stat-card dd {
  color: #dce5f2;
  font-weight: 650;
}

.quality-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(17, 24, 37, 0.72);
}

.quality-icon {
  display: grid;
  width: 27px;
  height: 27px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 8px;
  background: rgba(98, 217, 160, 0.1);
  color: var(--success);
  font-size: 14px;
  font-weight: 800;
}

.quality-icon--warning {
  background: rgba(240, 188, 104, 0.1);
  color: var(--warning);
}

.quality-card strong {
  color: #e4ebf6;
  font-size: 13px;
}

.quality-card p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
}

.missing-list {
  display: grid;
  gap: 0;
  margin-top: 10px;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: 11px;
}

.missing-list div {
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
  color: var(--muted);
  font-size: 12px;
}

.missing-list div:last-child {
  border-bottom: 0;
}

.missing-list strong {
  color: var(--warning);
}

.insight-list {
  display: grid;
  gap: 0;
  margin: 0;
  padding: 0 16px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(17, 24, 37, 0.72);
  list-style: none;
}

.insight-list li {
  display: flex;
  gap: 10px;
  padding: 13px 0;
  border-bottom: 1px solid var(--line);
  color: #c6d0de;
  font-size: 12px;
  line-height: 1.55;
}

.insight-list li:last-child {
  border-bottom: 0;
}

.insight-list span {
  color: #a7b3ff;
}

.correlation-grid {
  grid-template-columns: repeat(3, 1fr);
}

.correlation-card {
  padding: 12px 14px;
}

.correlation-card > div {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.correlation-card span {
  color: var(--muted);
  font-size: 11px;
}

.correlation-card strong {
  color: #e9f0fa;
  font-size: 14px;
}

.correlation-card > i {
  display: block;
  height: 5px;
  margin-top: 10px;
  overflow: hidden;
  border-radius: 99px;
  background: rgba(183, 196, 216, 0.1);
}

.correlation-card i b {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #7382f7, #a7b1ff);
}

.prediction-card {
  overflow: hidden;
  border: 1px solid rgba(148, 163, 255, 0.25);
  border-radius: 15px;
  background: linear-gradient(120deg, rgba(116, 132, 255, 0.16), rgba(27, 38, 62, 0.72));
}

/* ML model dashboard */
.best-model-hero {
  display:flex; align-items:center; justify-content:space-between; gap:16px; padding:18px; border:1px solid var(--line); border-radius:12px; background: linear-gradient(180deg, rgba(12,16,28,0.6), rgba(6,10,18,0.6));
}
.best-model-left h4 { margin:0; font-size:22px; color:#fff }
.best-model-metrics { display:flex; gap:18px; margin-top:8px }
.best-model-metrics div span { display:block; color:var(--muted); font-size:11px; font-weight:800 }
.best-model-metrics div strong { display:block; color:#eaf0f9; font-size:18px; margin-top:4px }
.best-badge { background: linear-gradient(90deg,#7ef0b2,#49c08a); color:#04210b; padding:6px 10px; border-radius:8px; font-weight:800 }
.best-note { color:var(--muted); margin:6px 0 0 }

.model-performance { display:grid; gap:12px; margin-top:12px }
.model-row { display:grid; gap:8px; align-items:center }
.model-row__meta { display:flex; justify-content:space-between; align-items:center; gap:12px }
.model-name { color:#eaf0f9 }
.model-stats { color:var(--muted); font-size:12px; display:flex; gap:10px; align-items:center }
.model-bar-track { height:12px; background: rgba(183,196,216,0.06); border-radius:999px; overflow:hidden; border:1px solid rgba(164,178,215,0.06) }
.model-bar { height:100%; background: linear-gradient(90deg,#8dd6b3,#6fcf99); transition: width 420ms cubic-bezier(.2,.9,.2,1) }
.model-row--best .model-bar { background: linear-gradient(90deg,#98b7ff,#7e8bff) }

.model-explainer { margin-top:10px; color:var(--muted); font-size:13px }

@media (prefers-reduced-motion: reduce) {
  .model-bar { transition: none !important }
}

.prediction-card > div {
  padding: 22px;
}

.prediction-card > div:first-child {
  border-right: 1px solid rgba(148, 163, 255, 0.18);
}

.prediction-card > div > strong {
  display: block;
  margin-top: 9px;
  color: #fff;
  font-size: clamp(30px, 4vw, 45px);
  font-weight: 700;
  letter-spacing: -0.055em;
}

.prediction-card > div > p {
  margin: 7px 0 0;
  color: #aebaff;
  font-size: 12px;
}

.prediction-input {
  display: grid;
  align-content: start;
  gap: 10px;
}

.prediction-input > span {
  margin-bottom: 4px;
}

.prediction-input div {
  color: var(--muted);
  font-size: 12px;
}

.prediction-input b {
  color: #d8e1ee;
  font-weight: 600;
}

.prediction-input em {
  color: #b8c4ff;
  font-style: normal;
}

.model-grid {
  grid-template-columns: repeat(3, 1fr);
}

.model-card {
  padding: 18px;
}

.model-card--best {
  border-color: rgba(150, 164, 255, 0.5);
  background: linear-gradient(150deg, rgba(112, 130, 255, 0.17), rgba(17, 24, 37, 0.82));
}

.model-card__title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
}

.model-card__title span {
  padding: 4px 5px;
  border: 1px solid rgba(165, 177, 255, 0.3);
  border-radius: 4px;
  color: #bdc7ff;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.07em;
}

.model-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 17px;
  margin-top: 18px;
}

.model-metrics strong {
  display: block;
  margin-top: 5px;
  color: #e8eff8;
  font-size: 14px;
}

.model-error {
  margin: 12px 0 0;
  color: var(--danger);
  font-size: 11px;
}

.research-answer {
  padding: clamp(18px, 3vw, 26px);
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(8, 13, 22, 0.4);
}

.research-answer h4 {
  margin: 16px 0 8px;
  color: #edf3fc;
  font-size: 15px;
}

.research-answer h4:first-child {
  margin-top: 0;
}

.research-answer p {
  margin: 0;
  color: #bdc8d8;
  font-size: 13px;
  line-height: 1.75;
}

.research-spacer {
  height: 11px;
}

.research-bullet {
  display: flex;
  gap: 9px;
}

.research-bullet span {
  color: #a7b3ff;
}

.source-grid {
  display: grid;
  gap: 10px;
}

.source-card {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 12px;
  padding: 14px;
  border-radius: 10px;
  border: 1px solid var(--line);
  background: rgba(15,20,30,0.6);
}

.source-number {
  color: #8998ff;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  display: grid;
  place-items: center;
  background: rgba(142,157,255,0.06);
  border-radius: 8px;
  width:36px; height:36px;
}

.source-card .source-title { margin:0; color:#eaf0f9; font-size:14px }
.source-excerpt { margin-top:8px; color:var(--muted); font-size:13px; line-height:1.5 }

.source-foot { display:flex; gap:10px; align-items:center; margin-top:10px }
.source-domain { color:var(--subtle); font-size:12px }
.source-date { color:var(--subtle); font-size:12px }
.source-link { margin-left:auto; color:#b4bfff; font-weight:700 }

.source-card p {
  margin: 0;
}

.source-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 12px;
  color: var(--subtle);
  font-size: 10px;
}

/* Research panel layout */
.research-panel { display:grid; grid-template-columns: 1fr 340px; gap:20px }
.research-main { display:flex; flex-direction:column; gap:18px }
.research-body { padding:14px; border:1px solid var(--line); border-radius:12px; background: rgba(8,12,20,0.5) }
.research-body p { color: #d7e4f6; line-height:1.75 }
.research-bullet { display:flex; gap:8px; color:#d7e4f6 }
.research-spacer { height:10px }

.research-side { display:flex; flex-direction:column; gap:14px }
.validation-summary { padding:12px; border:1px solid var(--line); border-radius:10px; background: rgba(8,12,20,0.4) }
.validation-summary h4 { margin:0 0 10px 0; color:#eaf0f9 }
.validation-grid { display:grid; grid-template-columns: repeat(2,1fr); gap:10px }
.validation-item span { display:block; color:var(--subtle); font-size:12px }
.validation-item strong { display:block; color:#eaf0f9; font-weight:800; margin-top:4px }

.research-meta-cards { display:grid; gap:10px }
.meta-card { padding:10px; border-radius:8px; border:1px solid var(--line); background: rgba(17,24,37,0.6) }
.meta-card span { display:block; color:var(--subtle); font-size:11px }
.meta-card strong { display:block; margin-top:6px; color:#eaf0f9; font-weight:800 }

.source-list-title { margin:0 0 8px 0; color:#eaf0f9 }

@media (max-width: 900px) {
  .research-panel { grid-template-columns: 1fr; }
  .research-side { order:2 }
}

.source-meta span + span::before {
  margin-right: 9px;
  color: #556175;
  content: "â€¢";
}

.source-card a {
  display: inline-block;
  margin-top: 12px;
  color: #b4bfff;
  font-size: 11px;
  font-weight: 700;
}

.source-card a b {
  margin-left: 3px;
}

footer {
  display: flex;
  justify-content: center;
  gap: 18px;
  padding: 28px 20px 36px;
  color: var(--subtle);
  font-size: 10px;
  letter-spacing: 0.06em;
}

footer strong {
  color: #b9c5d7;
}

@keyframes pulse {
  0% { transform: translateY(0) scale(1); opacity: 1 }
  50% { transform: translateY(-3px) scale(1.02); opacity: 0.95 }
  100% { transform: translateY(0) scale(1); opacity: 1 }
}

@keyframes glow-pulse {
  0% { box-shadow: 0 0 0 0 rgba(110,124,255,0.14) }
  70% { box-shadow: 0 0 20px 8px rgba(110,124,255,0.04) }
  100% { box-shadow: 0 0 0 0 rgba(110,124,255,0.0) }
}

/* Agent running/completed visual states */
.agent-card--running {
  border-color: rgba(124, 141, 255, 0.6);
  transform: translateY(-4px);
  animation: glow-pulse 1600ms infinite ease-in-out;
}

.agent-card--completed {
  border-color: rgba(98, 217, 160, 0.6);
  box-shadow: 0 6px 28px rgba(98, 217, 160, 0.06);
  transition: border-color 280ms ease, box-shadow 280ms ease, transform 200ms ease;
}

/* Activity marker transitions */
.activity-marker {
  transition: background 240ms ease, transform 220ms ease, color 200ms ease;
}

.activity-item--done .activity-marker {
  transform: scale(1.05);
}

.activity-item--active .activity-marker {
  color: white;
}

/* Result reveal */
.results { opacity: 0; transform: translateY(8px); transition: opacity 320ms ease, transform 320ms ease; }
.results--visible { opacity: 1; transform: translateY(0); }

/* Respect reduced motion preference */
@media (prefers-reduced-motion: reduce) {
  .agent-card--running, .agent-card--completed, .activity-list li, .results { animation: none !important; transition: none !important; transform: none !important; }
}

@media (max-width: 800px) {
  .header {
    height: 64px;
    padding: 0 20px;
  }

  .top-nav,
  .brand small {
    display: none;
  }

  .brand,
  .status {
    min-width: 0;
  }

  .main {
    width: min(100% - 28px, 680px);
    padding-top: 62px;
  }

  .workspace-heading,
  .result-header,
  .section-heading--wide {
    flex-direction: column;
  }

  .auto-route {
    width: 100%;
  }

  .section-heading--wide > p {
    text-align: left;
  }

  .metric-grid,
  .statistics-grid,
  .correlation-grid,
  .model-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .agent-grid {
    grid-template-columns: 1fr;
  }

  .agent-card {
    min-height: 0;
  }

  .agent-card h4 {
    margin-top: 16px;
  }

  .routing-panel {
    grid-template-columns: 1fr;
  }

  .routing-panel > div {
    min-height: 64px;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .routing-panel > div:last-child {
    border-bottom: 0;
  }

  .correlation-row {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .correlation-row small {
    justify-self: start;
  }
}

@media (max-width: 540px) {
  .status {
    color: var(--success);
    font-size: 0;
  }

  .composer-footer,
  .composer-actions {
    align-items: stretch;
    flex-wrap: wrap;
  }

  .composer-footer {
    flex-direction: column;
  }

  .composer-actions--right {
    width: 100%;
    margin-left: 0;
    justify-content: flex-end;
  }

  .file-name {
    max-width: calc(100vw - 130px);
  }

  .run-button {
    flex: 1;
  }

  .metric-grid,
  .statistics-grid,
  .correlation-grid,
  .model-grid,
  .schema-grid,
  .split-sections,
  .prediction-card {
    grid-template-columns: 1fr;
  }

  .correlation-row {
    grid-template-columns: 1fr;
  }

  .prediction-card > div:first-child {
    border-right: 0;
    border-bottom: 1px solid rgba(148, 163, 255, 0.18);
  }

  .result-header h2,
  .workspace-heading h2 {
    font-size: 25px;
  }

  footer {
    flex-wrap: wrap;
    gap: 10px;
  }
}
/* ORBIT ENTERPRISE UI v2 */

:root {
  --orbit-blue: #0f62fe;
  --orbit-blue-dark: #0043ce;
  --orbit-ink: #161616;
  --orbit-muted: #525252;
  --orbit-border: #d0d0d0;
  --orbit-surface: #ffffff;
  --orbit-soft: #f4f4f4;
  --orbit-grid: rgba(15, 98, 254, 0.055);
  --orbit-success: #198038;
}

html {
  scroll-behavior: smooth;
  background: #fff;
}

body {
  margin: 0;
  background: #fff;
  color: var(--orbit-ink);
  font-family: Arial, Helvetica, sans-serif;
}

#root {
  width: 100%;
  max-width: none;
  min-height: 100vh;
  margin: 0;
  border: 0;
  text-align: left;
  display: block;
}

.app {
  width: 100%;
  min-height: 100vh;
  background: #fff;
  color: var(--orbit-ink);
}

/* ---------- HEADER ---------- */

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  height: 64px;
  padding: 0 32px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,0.97);
  border-top: 3px solid var(--orbit-ink);
  border-bottom: 1px solid var(--orbit-border);
  backdrop-filter: blur(10px);
}

.header-left {
  display: flex;
  align-items: center;
  min-width: 220px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--orbit-ink);
  text-decoration: none;
}

.brand strong {
  font-size: 24px;
  line-height: 1;
  letter-spacing: -1px;
  font-weight: 700;
}

.brand small {
  display: block;
  color: var(--orbit-muted);
  font-size: 11px;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.agent-icon {
  width: 32px;
  height: 32px;
  border: 1px solid var(--orbit-ink);
  display: grid;
  place-items: center;
  background: #fff;
  color: var(--orbit-blue);
  font-weight: 700;
}

.header-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.top-nav {
  display: flex;
  align-items: center;
  gap: 4px;
}

.top-nav a {
  padding: 22px 18px;
  color: var(--orbit-ink);
  text-decoration: none;
  font-size: 14px;
  border-bottom: 3px solid transparent;
  transition: .18s ease;
}

.top-nav a:hover {
  color: var(--orbit-blue);
  border-bottom-color: var(--orbit-blue);
  background: var(--orbit-soft);
}

.header-right {
  min-width: 180px;
  display: flex;
  justify-content: flex-end;
}

.ready {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--orbit-ink);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.ready i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--orbit-success);
  box-shadow: 0 0 0 4px rgba(25,128,56,.1);
}

/* ---------- MAIN ---------- */

.main {
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 540px;
  padding: 110px 7vw 90px;
  box-sizing: border-box;
  background:
    linear-gradient(90deg, transparent 0 9%, var(--orbit-grid) 9% 9.1%, transparent 9.1% 100%),
    linear-gradient(0deg, transparent 0 19%, var(--orbit-grid) 19% 19.1%, transparent 19.1% 100%),
    #fff;
  border-bottom: 1px solid var(--orbit-border);
}

.hero::after {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  right: -150px;
  top: -180px;
  background: linear-gradient(135deg, rgba(15,98,254,.12), rgba(120,70,255,.08));
  transform: rotate(12deg);
  pointer-events: none;
}

.hero > * {
  position: relative;
  z-index: 1;
}

.section-heading > span,
.eyebrow {
  color: var(--orbit-blue);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.hero h1 {
  max-width: 850px;
  margin: 22px 0 24px;
  color: var(--orbit-ink);
  font-size: clamp(52px, 7vw, 92px);
  line-height: .98;
  letter-spacing: -4px;
  font-weight: 400;
}

.hero p {
  max-width: 680px;
  color: var(--orbit-muted);
  font-size: 19px;
  line-height: 1.55;
}

/* ---------- SECTIONS ---------- */

.workspace,
.agents-section,
.result-section,
.results {
  max-width: 1280px;
  margin: 0 auto;
  padding: 80px 7vw;
  box-sizing: border-box;
}

.section-heading {
  margin-bottom: 34px;
}

.section-heading h3 {
  margin: 8px 0;
  color: var(--orbit-ink);
  font-size: 38px;
  line-height: 1.1;
  font-weight: 400;
  letter-spacing: -1.5px;
}

.section-heading--wide > p {
  max-width: 650px;
  color: var(--orbit-muted);
}

/* ---------- WORKSPACE ---------- */

.workspace {
  background: #fff;
}

.auto-route {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 0;
  margin-bottom: 18px;
  color: var(--orbit-muted);
  border-top: 1px solid var(--orbit-border);
  border-bottom: 1px solid var(--orbit-border);
}

.auto-route strong {
  color: var(--orbit-ink);
}

.auto-route small {
  color: var(--orbit-muted);
}

.composer {
  background: #fff;
  border: 1px solid var(--orbit-ink);
  border-radius: 0;
  box-shadow: 8px 8px 0 var(--orbit-blue);
  transition: box-shadow .2s ease;
}

.composer:focus-within {
  border-color: var(--orbit-blue);
  box-shadow: 10px 10px 0 var(--orbit-blue);
}

.composer-top textarea,
textarea {
  width: 100%;
  min-height: 150px;
  padding: 24px;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  resize: vertical;
  outline: 0;
  color: var(--orbit-ink);
  background: #fff;
  font-size: 18px;
  line-height: 1.55;
}

.composer-top textarea::placeholder {
  color: #8d8d8d;
}

.composer-footer {
  min-height: 62px;
  padding: 10px 14px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--orbit-border);
}

.composer-actions {
  gap: 10px;
}

.upload,
.clear-button,
.run-button,
.action-btn {
  border-radius: 0;
  font-weight: 600;
  transition: .18s ease;
}

.upload {
  border: 1px solid var(--orbit-border);
  background: #fff;
  color: var(--orbit-ink);
}

.upload:hover {
  border-color: var(--orbit-blue);
  color: var(--orbit-blue);
}

.clear-button {
  border: 0;
  background: transparent;
  color: var(--orbit-muted);
}

.clear-button:hover {
  color: var(--orbit-blue);
}

.run-button {
  min-height: 44px;
  padding: 0 24px;
  border: 0;
  background: var(--orbit-blue);
  color: #fff;
}

.run-button:hover:not(:disabled) {
  background: var(--orbit-blue-dark);
  transform: translateY(-1px);
}

.run-button .run-arrow {
  margin-left: 14px;
}

/* ---------- AGENTS ---------- */

.agents-section {
  background: var(--orbit-soft);
  max-width: none;
  padding-left: max(7vw, calc((100% - 1280px) / 2));
  padding-right: max(7vw, calc((100% - 1280px) / 2));
}

.agent-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border-top: 1px solid var(--orbit-ink);
  border-bottom: 1px solid var(--orbit-ink);
}

.agent-item {
  min-height: 220px;
  padding: 28px;
  display: flex;
  align-items: flex-start;
  gap: 22px;
  text-align: left;
  border: 0;
  border-right: 1px solid var(--orbit-border);
  border-radius: 0;
  background: #fff;
  color: var(--orbit-ink);
  cursor: pointer;
  transition: .2s ease;
}

.agent-item:last-child {
  border-right: 0;
}

.agent-item:hover,
.agent-item--selected {
  background: var(--orbit-blue);
  color: #fff;
}

.agent-item__icon {
  flex: 0 0 auto;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 0;
  border: 1px solid currentColor;
  background: transparent;
  font-weight: 700;
}

.agent-item__meta strong {
  display: block;
  margin-bottom: 10px;
  font-size: 21px;
  font-weight: 500;
}

.agent-item__meta small {
  color: var(--orbit-muted);
  font-size: 14px;
  line-height: 1.5;
}

.agent-item:hover .agent-item__meta small,
.agent-item--selected .agent-item__meta small {
  color: rgba(255,255,255,.8);
}

/* ---------- ACTIVITY ---------- */

.activity-card {
  background: #fff;
  border: 1px solid var(--orbit-border);
  border-radius: 0;
  box-shadow: none;
}

.activity-list {
  padding: 0;
}

.activity-item {
  min-height: 58px;
  margin: 0;
  padding: 12px 18px;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 38px 1fr auto;
  align-items: center;
  gap: 14px;
  border-radius: 0;
  border-bottom: 1px solid var(--orbit-border);
  background: #fff;
}

.activity-item:last-child {
  border-bottom: 0;
}

.activity-marker {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--orbit-soft);
  color: var(--orbit-blue);
  border: 1px solid var(--orbit-border);
}

.activity-text {
  color: var(--orbit-ink);
  font-weight: 600;
}

.activity-meta {
  color: var(--orbit-muted);
  font-size: 12px;
}

/* ---------- RESULTS ---------- */

.results {
  max-width: 1280px;
  background: #fff;
}

.result-header {
  padding: 30px 0;
  border-radius: 0;
  border-top: 2px solid var(--orbit-ink);
  border-bottom: 1px solid var(--orbit-border);
}

.result-header-left {
  display: flex;
  gap: 18px;
  align-items: center;
}

.agent-avatar {
  width: 56px;
  height: 56px;
  border-radius: 0;
  display: grid;
  place-items: center;
  background: var(--orbit-blue);
  color: #fff;
  font-weight: 700;
  font-size: 17px;
}

.result-header h2 {
  margin: 4px 0;
  color: var(--orbit-ink);
  font-size: 34px;
  font-weight: 400;
  letter-spacing: -1px;
}

.result-provider {
  margin-top: 5px;
  color: var(--orbit-blue);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .02em;
}

.status-pill {
  border-radius: 0;
  border: 1px solid var(--orbit-success);
  background: #fff;
  color: var(--orbit-success);
}

.execution-compact {
  border-radius: 0;
  background: var(--orbit-soft);
  border: 1px solid var(--orbit-border);
  color: var(--orbit-ink);
}

.execution-panel {
  margin-top: 0;
  padding: 22px 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border-radius: 0;
  border-bottom: 1px solid var(--orbit-border);
}

.execution-panel > div {
  padding: 8px 22px;
  border-left: 3px solid var(--orbit-blue);
}

.execution-panel > div + div {
  border-left: 1px solid var(--orbit-border);
}

.execution-panel span {
  display: block;
  margin-bottom: 6px;
  color: var(--orbit-muted);
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.execution-panel strong {
  color: var(--orbit-ink);
  font-size: 15px;
}

.result-content {
  margin-top: 34px;
}

.result-content h3 {
  color: var(--orbit-ink);
  font-size: 22px;
  font-weight: 500;
}

.result-content pre,
.result-content .response,
.result-content > div {
  border-radius: 0;
}

.action-btn {
  min-height: 38px;
  padding: 0 14px;
  border: 1px solid var(--orbit-border);
  background: #fff;
  color: var(--orbit-ink);
}

.action-btn:hover {
  border-color: var(--orbit-blue);
  color: var(--orbit-blue);
  background: #f8fbff;
}

/* ---------- RESEARCH / DATA / ML ---------- */

.research-panel {
  border-top: 1px solid var(--orbit-border);
}

.source-card,
.agent-card {
  border-radius: 0;
  border: 1px solid var(--orbit-border);
  background: #fff;
  box-shadow: none;
}

.agent-card:hover {
  border-color: var(--orbit-blue);
  transform: none;
}

/* ---------- FOOTER / LOWER UI ---------- */

.app a {
  color: var(--orbit-blue);
}

.app button:focus-visible,
.app a:focus-visible,
.app textarea:focus-visible,
.app input:focus-visible {
  outline: 2px solid var(--orbit-blue);
  outline-offset: 3px;
}

/* ---------- RESPONSIVE ---------- */

@media (max-width: 900px) {
  .header {
    padding: 0 18px;
  }

  .header-center {
    display: none;
  }

  .header-left {
    min-width: auto;
  }

  .header-right {
    min-width: auto;
  }

  .hero {
    min-height: auto;
    padding: 80px 24px 70px;
  }

  .hero h1 {
    font-size: clamp(46px, 11vw, 72px);
    letter-spacing: -2.5px;
  }

  .workspace,
  .result-section,
  .results {
    padding: 60px 24px;
  }

  .agents-section {
    padding: 60px 24px;
  }

  .agent-list {
    grid-template-columns: 1fr;
  }

  .agent-item {
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid var(--orbit-border);
  }

  .agent-item:last-child {
    border-bottom: 0;
  }
}

@media (max-width: 600px) {
  .header {
    height: 58px;
  }

  .brand small {
    display: none;
  }

  .hero h1 {
    font-size: 48px;
  }

  .hero p {
    font-size: 16px;
  }

  .section-heading h3 {
    font-size: 30px;
  }

  .composer {
    box-shadow: 5px 5px 0 var(--orbit-blue);
  }

  .composer-footer {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }

  .composer-actions,
  .composer-actions--right {
    width: 100%;
    justify-content: space-between;
  }

  .run-button {
    flex: 1;
  }

  .result-header-left {
    align-items: flex-start;
  }

  .result-header h2 {
    font-size: 27px;
  }

  .execution-panel {
    grid-template-columns: 1fr;
  }

  .execution-panel > div + div {
    border-left: 3px solid var(--orbit-blue);
    border-top: 1px solid var(--orbit-border);
  }
}