# Backend environment example for production
# Render provides the port via $PORT
PORT=10000
# CORS allowed origins – set to your Vercel domain(s)
ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Task registry settings (optional)
TASK_TTL_SECONDS=1800
TASK_MAX_DURATION=300
# Logging level
LOG_LEVEL=INFO
# Placeholder API keys (do NOT commit real secrets)
ORBIT_API_KEY=
GEMINI_API_KEY=
FREELLMAPI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
